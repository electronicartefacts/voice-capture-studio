{
  "name": "voice-capture-studio",
  "version": "0.1.0",
  "description": "Local-first browser studio for directed voice capture and dataset-ready metadata.",
  "license": "MIT",
  "author": "Electronic Artefacts",
  "type": "module",
  "homepage": "https://electronicartefacts.github.io/voice-capture-studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/electronicartefacts/voice-capture-studio.git"
  },
  "bugs": {
    "url": "https://github.com/electronicartefacts/voice-capture-studio/issues"
  },
  "keywords": [
    "audio",
    "dataset",
    "local-first",
    "react",
    "voice-capture",
    "web-audio"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node check-build-budget.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "npm run build && vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.tsx' --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "lucide-react": "^1.28.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
